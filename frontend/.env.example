# ── API wiring ──────────────────────────────────────────────────
# Dev: leave VITE_API_URL empty to use the Vite proxy (/api -> backend).
# Prod: set to the full backend tRPC endpoint,
#       e.g. https://api.example.com/api/trpc
VITE_API_URL=

# Where the Vite dev server proxies /api during `npm run dev`
VITE_BACKEND_URL=http://localhost:8787

# ── Kimi OAuth (exposed to the browser) ─────────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
