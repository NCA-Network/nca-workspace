# ── API wiring ──────────────────────────────────────────────────
# Dev: leave NEXT_PUBLIC_API_URL empty — calls hit "/api/*" and Next's
#      rewrite (next.config.ts) proxies them to BACKEND_URL.
# Prod: if the frontend and backend are on different origins, set
#       NEXT_PUBLIC_API_URL to the backend origin (e.g. https://api.example.com).
NEXT_PUBLIC_API_URL=

# Where Next's dev proxy forwards /api/* (server-side only)
BACKEND_URL=http://localhost:8787

# Auth (Google sign-in) is configured entirely on the backend — the frontend
# just navigates to /api/auth/google. No public auth vars are needed here.
