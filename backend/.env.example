# ── Server ──────────────────────────────────────────────────────
PORT=8787                            # Port the API server listens on
FRONTEND_URL=http://localhost:3000   # Allowed CORS origin (the frontend app)

# ── App / Auth (Kimi OAuth) ─────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)
OWNER_UNION_ID=           # Union ID of the app creator; gets role "admin" on first login

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── AI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=           # OpenAI API key (used by the AI router)
