# ── Server ──────────────────────────────────────────────────────
PORT=8787                            # Port the API server listens on
FRONTEND_URL=http://localhost:3000   # Allowed CORS origin (the frontend app)

# ── Session ─────────────────────────────────────────────────────
APP_SECRET=               # Secret used to sign session JWTs

# ── Google OAuth (sign-in) ──────────────────────────────────────
GOOGLE_CLIENT_ID=         # OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_SECRET=     # OAuth 2.0 Client Secret
# Optional — defaults to ${FRONTEND_URL}/api/auth/google/callback.
# Must exactly match an "Authorized redirect URI" in the Google console.
GOOGLE_REDIRECT_URI=

# ── Database (PostgreSQL via Prisma) ────────────────────────────
# Cloud Postgres connection string, e.g.
#   postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL=
# Optional: some pooled providers (Neon/Supabase pgbouncer) need a direct,
# non-pooled URL for `prisma migrate`. If so, uncomment in prisma/schema.prisma.
# DIRECT_URL=

# ── AI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=           # OpenAI API key (used by the AI service)

# ── WhatsApp webhook (optional) ─────────────────────────────────
WHATSAPP_VERIFY_TOKEN=    # Token echoed back during provider webhook verification
